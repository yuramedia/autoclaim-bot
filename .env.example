# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_bot_client_id

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/autoclaim-bot

# Runtime Environment
# development | production (default: development)
NODE_ENV=development

# Scheduler Settings (24-hour format, UTC+8 timezone)
# Default: 00:00 AM UTC+8 (midnight)
CLAIM_HOUR=0
CLAIM_MINUTE=0

# Crunchyroll Configuration
# Required for account-scoped features: etp_rt cookie from a logged-in browser.
CR_ETP_RT=
# Optional advanced overrides. Leave empty to use auto-synced AndroidTV constants.
CR_BASIC_AUTH=
CR_USER_AGENT=
CR_AUTO_UPDATE_CREDENTIALS=true

# U2 BDMV Torrent Feed
# Full RSS URL including passkey from https://u2.dmhy.org/torrentrss.php
# Example: https://u2.dmhy.org/torrentrss.php?rows=50&cat16=1&icat=1&ismalldescr=1&isize=1&iuplder=1&trackerssl=1&passkey=your_passkey_here
U2_RSS_URL=

# ameNZB Search API
# Get your API key from https://amenzb.moe/profile
# Make sure your bot's IP is pinned in Account Settings → IP Security
AMENZB_API_KEY=

# Token Encryption Key
# Used to encrypt Hoyolab and Endfield tokens stored in MongoDB.
# Any random string works. Generate one with: openssl rand -hex 32
# REQUIRED — bot will refuse to start without this.
TOKEN_ENCRYPTION_KEY=
