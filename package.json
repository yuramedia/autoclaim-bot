    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "axios": "^1.17.0",
        "cheerio": "^1.2.0",
        "discord.js": "^14.26.4",
        "dotenv": "^17.4.2",
        "graphql": "^16.14.2",
        "graphql-request": "^7.4.0",
        "he": "^1.2.0",
        "mongoose": "^9.7.0",
        "node-cron": "^4.2.1",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "universal-speedtest": "^3.0.0",
        "xml2js": "^0.6.2"
    }
