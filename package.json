{
    "name": "autoclaim-bot",
    "module": "src/index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "start": "bun run src/index.ts",
        "dev": "bun --watch run src/index.ts",
        "deploy": "bun run src/deploy-commands.ts",
        "test": "bun test --preload ./src/test-setup.ts",
        "format": "bunx oxfmt",
        "format:check": "bunx oxfmt --check",
        "lint": "bunx oxlint",
        "lint:fix": "bunx oxlint --fix",
        "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/he": "^1.2.3",
        "@types/node-cron": "^3.0.11",
        "@types/xml2js": "^0.4.14",
        "oxfmt": "^0.58.0",
        "oxlint": "^1.73.0",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "axios": "^1.18.1",
        "cheerio": "^1.2.0",
        "discord.js": "^14.26.5",
        "dotenv": "^17.4.2",
        "graphql": "^17.0.2",
        "graphql-request": "^7.4.0",
        "he": "^1.2.0",
        "mongoose": "^9.7.4",
        "node-cron": "^4.6.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "xml2js": "^0.6.2"
    }
}
